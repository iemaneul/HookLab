generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Environment {
  development
  staging
  production
}

enum EndpointStatus {
  active
  paused
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspaces Workspace[]
}
model Workspace {
  id String @id @default(cuid())
  name String
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoints WebhookEndpoint[]
  apiKeys ApiKey[]
  @@index([userId])
}
model WebhookEndpoint {
  id String @id @default(cuid())
  workspaceId String
  name String
  slug String @unique
  environment Environment @default(development)
  status EndpointStatus @default(active)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requests WebhookRequest[]
  @@index([workspaceId])
  @@index([slug])
}
model WebhookRequest {
  id String @id @default(cuid())
  endpointId String
  method String
  status Int @default(200)
  event String @default("unknown")
  headers Json
  query Json
  body Json?
  responseBody Json?
  responseTime Int
  ip String?
  userAgent String?
  receivedAt DateTime @default(now())
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  replays ReplayRequest[]
  @@index([endpointId])
  @@index([receivedAt])
  @@index([status])
  @@index([event])
}
model ReplayRequest {
  id String @id @default(cuid())
  webhookRequestId String
  destinationUrl String
  method String
  status Int?
  responseBody Json?
  responseTime Int
  createdAt DateTime @default(now())
  webhookRequest WebhookRequest @relation(fields: [webhookRequestId], references: [id], onDelete: Cascade)
  @@index([webhookRequestId])
}
model ApiKey {
  id String @id @default(cuid())
  workspaceId String
  name String
  keyHash String
  prefix String
  environment Environment
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId])
}
